# ATS model route (resume extraction/suggestions/ATS)
ATS_API_KEY=your_ats_api_key_here
ATS_CHAT_ENDPOINT=https://api.oxlo.ai/v1/chat/completions
ATS_MODEL=deepseek-r1-8b

# JD model route (JD matching analysis)
JD_API_KEY=your_jd_api_key_here
JD_CHAT_ENDPOINT=https://api.oxlo.ai/v1/chat/completions
JD_MODEL=deepseek-v3.2

# Roadmap model route (weekly task generation)
# Dedicated key used only for roadmap generation (no fallback to OXLO_API_KEY)
ROADMAP_API_KEY=your_roadmap_api_key_here
ROADMAP_CHAT_ENDPOINT=https://api.oxlo.ai/v1/chat/completions
ROADMAP_MODEL=gpt-oss-20b

# Quiz model route (adaptive quiz generation)
QUIZ_API_KEY=your_quiz_api_key_here
QUIZ_CHAT_ENDPOINT=https://api.oxlo.ai/v1/chat/completions
QUIZ_MODEL=deepseek-coder-33b
QUIZ_STRICT_MODEL=true

# Interview model route (mock interview generation + scoring)
INTERVIEW_API_KEY=your_interview_api_key_here
INTERVIEW_CHAT_ENDPOINT=https://api.oxlo.ai/v1/chat/completions
INTERVIEW_MODEL=gemma-3-27b

# Backward-compatible legacy defaults (optional)
OXLO_API_KEY=
OXLO_FALLBACK_API_KEY=
OXLO_CHAT_ENDPOINT=https://api.oxlo.ai/v1/chat/completions
OXLO_MODEL=deepseek-r1-8b
OXLO_EMBEDDINGS_ENDPOINT=https://api.oxlo.ai/v1/embeddings

# Fallback policy (fallbacks are used only when provider returns rate-limit)
ENABLE_RATE_LIMIT_FALLBACK=true

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
API_KEY_ENCRYPTION_SECRET=change_this_to_a_long_random_secret

# Job Search APIs
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
RAPIDAPI_KEY=your_rapidapi_key

# Server Config
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Redis (optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL_MINUTES=15

# Job Search Config
MAX_JOBS_PER_QUERY=50
MIN_SKILL_MATCH_RATIO=0.6
API_TIMEOUT_SECONDS=10
